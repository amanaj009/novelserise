<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/messageContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Space used to push Sent messages to the right -->
    <View
        android:id="@+id/leftEmptySpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/messageWrapperContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/messageWrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble_received"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="John Doe"
                tools:visibility="visible" />

            <!-- Using ShapeableImageView to match bubble corners -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageViewMessage"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize8dp"
                tools:src="@tools:sample/backgrounds/scenic"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textViewMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="This is a sample message." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewSendTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp"
                tools:text="10:30 AM" />

            <TextView
                android:id="@+id/textViewSeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="Seen"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

    <!-- Space used to push Received messages to the left -->
    <View
        android:id="@+id/rightEmptySpace"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>