<?xml version="1.0" encoding="utf-8"?>
<!-- Light theme hero card; the dark navy version lives in drawable-night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#FFF4F7"
        android:centerColor="#FBF5FA"
        android:endColor="#FCE9F1" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#40FF176B" />
</shape>
