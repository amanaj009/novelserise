<!-- Empty-state art: icon on a rounded gradient tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="84dp" android:height="84dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#FF4F8B" android:endColor="#7C3AED" />
        </shape>
    </item>
    <item android:width="40dp" android:height="40dp" android:gravity="center"
        android:drawable="@drawable/ic_invite_people" />
</layer-list>
