<!-- Gift tile (store grid, free row, owned list): glowing image, name, price, action pill. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_shop_pack"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="60dp">

        <View
            android:layout_width="72dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_gift_glow" />

        <ImageView
            android:id="@+id/ivGift"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_gift" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGiftName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Rose" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="💎 10" />

    <TextView
        android:id="@+id/btnGrabOrBuy"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_gradient_button"
        android:gravity="center"
        android:text="Grab"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
