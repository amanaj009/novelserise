<!--
  Unlock chapter sheet: context header (cover + chapter), payment-method choice cards, ad option
  and one primary action. Plain views; backgrounds/colours are applied in
  UnlockChapterBottomSheetNew.applyTheme() so it follows the app or reader theme.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <View
        android:id="@+id/drag_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp" />

    <!-- Header: cover with lock badge + chapter info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="96dp">

            <com.writer_hub.novelserise.ui.custom.CoverImageView
                android:id="@+id/ivCover"
                android:layout_width="60dp"
                android:layout_height="90dp"
                android:src="@drawable/placeholder2" />

            <FrameLayout
                android:id="@+id/lockBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end">

                <ImageView
                    android:id="@+id/iv_lock_status"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lock" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLockedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="LOCKED CHAPTER"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/title_unlock_chapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Martial Arts Samrat - Chapter 6" />

            <TextView
                android:id="@+id/text_for_unlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="Martial Arts Samrat" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvChooseLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:letterSpacing="0.08"
        android:text="CHOOSE HOW TO UNLOCK"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Pay with diamonds -->
    <LinearLayout
        android:id="@+id/diamonds_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/diamondsIconBadge"
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/diamonds_card_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_diamonds_income" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/diamonds_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay with Diamonds"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/diamonds_card_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                tools:text="Balance: 0 · Need 4 more" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDiamondPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="4" />

        <View
            android:id="@+id/radioDiamonds"
            android:layout_width="22dp"
            android:layout_height="22dp" />
    </LinearLayout>

    <!-- Pay with points -->
    <LinearLayout
        android:id="@+id/points_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/pointsIconBadge"
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/points_card_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_point_daily" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/points_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay with Points"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/points_card_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                tools:text="Balance: 0 · Need 10 more" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPointsPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="10" />

        <View
            android:id="@+id/radioPoints"
            android:layout_width="22dp"
            android:layout_height="22dp" />
    </LinearLayout>

    <!-- Watch an ad -->
    <LinearLayout
        android:id="@+id/ads_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/adsIconBadge"
            android:layout_width="42dp"
            android:layout_height="42dp">

            <ImageView
                android:id="@+id/ads_card_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_player_play" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ads_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Watch an ad"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ads_card_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Earn free diamonds"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFreeTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="FREE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/adsChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <!-- Main action -->
    <FrameLayout
        android:id="@+id/layout_unlock_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/button_unlock_chapter"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Unlock for 4 diamonds" />

        <ProgressBar
            android:id="@+id/progress_unlock_chapter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Secondary links -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/button_earn_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Earn points"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/linkDot"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginHorizontal="10dp" />

        <TextView
            android:id="@+id/button_buy_diamonds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Buy diamonds"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
