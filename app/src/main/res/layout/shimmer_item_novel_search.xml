<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <View
            android:id="@+id/ivNovelCover"
            android:layout_width="80dp"
            android:layout_height="120dp"
            android:background="@drawable/shimmer_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/tvNovelTitle"
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivNovelCover"
            app:layout_constraintTop_toTopOf="@id/ivNovelCover" />

        <View
            android:id="@+id/tvWriterName"
            android:layout_width="100dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/shimmer_placeholder"
            app:layout_constraintStart_toStartOf="@id/tvNovelTitle"
            app:layout_constraintTop_toBottomOf="@id/tvNovelTitle" />

        <View
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNovelTitle"
            app:layout_constraintTop_toBottomOf="@id/tvWriterName" />

        <View
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvNovelTitle"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>