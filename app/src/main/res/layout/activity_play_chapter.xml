<?xml version="1.0" encoding="utf-8"?>
<!--
  Chapter player page. Same look as the full audio player (rounded cover, white round play button,
  slim seek bar) with the lightweight view setup used on the home/detail pages: no card views,
  no duplicate backgrounds (the window is already the surface colour).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More options"
                android:padding="12dp"
                android:src="@drawable/ic_more_vert"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnSurface" />

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Share"
                android:padding="13dp"
                android:src="@drawable/ic_player_share"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMore"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnSurface" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="gone">
        <include layout="@layout/shimmer_play_chapter" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <!-- One scroll for the whole page: the player section scrolls away, the tabs stay pinned,
             and each tab's list (chapters, comments, details) drives it via nested scrolling. -->
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/adContainer"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.AppBarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/playerSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="12dp"
                    app:layout_scrollFlags="scroll">

                    <!-- Cover (2:3, rounded) with an optional native ad on top of it. -->
                    <FrameLayout
                        android:id="@+id/cardCover"
                        android:layout_width="104dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintDimensionRatio="2:3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.writer_hub.novelserise.ui.custom.CoverImageView
                            android:id="@+id/ivCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/placeholder2"
                            app:coverCornerRadius="10dp" />

                        <FrameLayout
                            android:id="@+id/nativeAdContainer"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvChapterTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="Chapter Title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tvNovelTitle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardCover"
                        app:layout_constraintTop_toTopOf="@id/cardCover"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/tvNovelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="20dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Novel Title"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toTopOf="@id/tvViewFullScreen"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardCover"
                        app:layout_constraintTop_toBottomOf="@id/tvChapterTitle" />

                    <TextView
                        android:id="@+id/tvViewFullScreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_primary_pill"
                        android:foreground="?attr/selectableItemBackground"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/view_full_screen"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/tagsRow"
                        app:layout_constraintStart_toEndOf="@id/cardCover"
                        app:layout_constraintTop_toBottomOf="@id/tvNovelTitle" />

                    <!-- Category + sub-category tags, same style as the novel detail page. -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tagsRow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:visibility="gone"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp"
                        app:layout_constraintBottom_toBottomOf="@id/cardCover"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardCover"
                        app:layout_constraintTop_toBottomOf="@id/tvViewFullScreen"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_detail_tag"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="Romance"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvSubCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_detail_tag"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:visibility="gone"
                            tools:text="Billionaire Romance"
                            tools:visibility="visible" />
                    </com.google.android.material.chip.ChipGroup>

                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginTop="20dp"
                        android:maxHeight="4dp"
                        android:minHeight="4dp"
                        android:paddingVertical="10dp"
                        android:progressDrawable="@drawable/player_seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/player_seekbar_thumb"
                        app:layout_constraintTop_toBottomOf="@id/cardCover" />

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:fontFeatureSettings="tnum"
                        android:text="00:00"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/seekBar" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:fontFeatureSettings="tnum"
                        android:text="00:00"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/seekBar" />

                    <LinearLayout
                        android:id="@+id/controlsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="12dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        app:layout_constraintTop_toBottomOf="@id/tvCurrentTime">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/btnPrevious"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Previous chapter"
                                android:padding="12dp"
                                android:src="@drawable/ic_player_skip_previous"
                                app:tint="?attr/colorOnSurface" />

                            <ProgressBar
                                android:id="@+id/progressPrevious"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="?attr/colorOnSurface"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/btnRewind"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Rewind 10 seconds"
                                android:padding="12dp"
                                android:src="@drawable/ic_player_replay_10"
                                app:tint="?attr/colorOnSurface" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            android:layout_marginHorizontal="4dp">

                            <ImageView
                                android:id="@+id/btnPlayPause"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_player_play_button"
                                android:contentDescription="Play or pause"
                                android:padding="20dp"
                                android:src="@drawable/ic_player_play"
                                app:tint="?attr/colorSurface" />

                            <ProgressBar
                                android:id="@+id/progressBarLoading"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:indeterminateTint="?attr/colorSurface"
                                android:padding="20dp"
                                android:visibility="gone" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/btnForward"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Forward 10 seconds"
                                android:padding="12dp"
                                android:src="@drawable/ic_player_forward_10"
                                app:tint="?attr/colorOnSurface" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/btnNext"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_gravity="center"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Next chapter"
                                android:padding="12dp"
                                android:src="@drawable/ic_player_skip_next"
                                app:tint="?attr/colorOnSurface" />

                            <ProgressBar
                                android:id="@+id/progressNext"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="?attr/colorOnSurface"
                                android:visibility="gone" />
                        </FrameLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutGiftAd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/controlsLayout">

                        <!-- Small banner ad slot (was a MaterialCardView with elevation). -->
                        <FrameLayout
                            android:id="@+id/cardSmallAd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:visibility="gone">

                            <FrameLayout
                                android:id="@+id/smallBannerAdContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="50dp" />
                        </FrameLayout>

                        <!-- Outlined gold "Send Gift" button, same as the novel detail page. -->
                        <LinearLayout
                            android:id="@+id/btnGift"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_gift_button"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_gift_premium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="@string/send_gift"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="?attr/colorPrimary"
                    app:tabIndicatorFullWidth="false"
                    app:tabIndicatorHeight="3dp"
                    app:tabMode="fixed"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="?attr/colorOnSurface"
                    app:tabTextColor="?attr/colorOnSurfaceVariant" />

            </com.google.android.material.appbar.AppBarLayout>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
