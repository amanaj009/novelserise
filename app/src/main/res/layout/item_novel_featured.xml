<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp">

    <!-- One rounded view instead of a shadowed card + image: less overdraw while scrolling. -->
    <com.writer_hub.novelserise.ui.custom.CoverImageView
        android:id="@+id/ivNovelCover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tvNovelTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="12sp"
        android:letterSpacing="0.01"
        app:layout_constraintTop_toBottomOf="@id/ivNovelCover"
        tools:text="Novel Title Long Name Goes Here" />

</androidx.constraintlayout.widget.ConstraintLayout>