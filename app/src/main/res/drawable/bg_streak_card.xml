<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@color/shop_card" />
            <stroke android:width="1dp" android:color="@color/shop_card_stroke" />
        </shape>
    </item>
    <item android:bottom="120dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
            <gradient android:angle="270" android:startColor="#26F97316" android:endColor="#00F97316" />
        </shape>
    </item>
</layer-list>
