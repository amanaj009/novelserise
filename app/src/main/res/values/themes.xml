<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NovelSerise" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/pink_500</item>
        <item name="colorPrimaryVariant">@color/pink_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/pink_200</item>
        <item name="colorSecondaryVariant">@color/pink_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Surface and Outline colors (Used in Settings and other screens) -->
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/pink_10</item>
        <item name="colorOnSurfaceVariant">@color/gray_700</item> <!-- Darker gray for better contrast -->
        <item name="colorOutline">@color/gray_200</item>
        <item name="colorOutlineVariant">@color/gray_200</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/gray_800</item>
        <item name="android:textColorHint">@color/gray_600</item>

        <!-- Custom attributes values -->
        <item name="textColorPrimary">@color/black</item>
        <item name="track_color_activated">@color/pink_500</item>
        <item name="track_color_normal">@color/gray_500</item>

        <!-- Container colors for M3 compatibility -->
        <item name="colorPrimaryContainer">@color/pink_50</item>
        <item name="colorOnPrimaryContainer">@color/pink_700</item>

        <!-- Custom attributes -->
        <item name="novel_app_gold_accent">@color/novel_app_gold_accent</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Bottom Navigation Bar (System) -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Edge-to-edge colors for EdgeToEdgeHelper -->
        <item name="appStatusBarColor">@color/white</item>
        <item name="appNavigationBarColor">@color/white</item>
        <item name="appWindowBackground">@color/white</item>

        <!-- Status Colors -->
        <item name="colorSuccess">#2E7D32</item>
        <item name="genreRomance">#FF6B6B</item>
        <item name="genreThriller">#845EF7</item>
        <item name="genreMystery">#339AF0</item>
        <item name="genreDrama">#F76707</item>
        <item name="genreFantasy">#20C997</item>
        <item name="genreAction">#FF922B</item>
        <item name="genreAdventure">#51CF66</item>
        <item name="genreHorror">#5C5C5C</item>
        <item name="genreSciFi">#15AABF</item>
        <item name="genreHistorical">#A52A2A</item>
        <item name="genreComedy">#FCC419</item>

        <item name="rankGold">#FFD700</item>
        <item name="rankSilver">#C0C0C0</item>
        <item name="rankBronze">#CD7F32</item>

        <item name="palette_brand_orange">#E68900</item>
        <item name="palette_brand_blue">#4285F4</item>

        <item name="colorOverlayLow">#1A000000</item>
        <item name="colorOverlayHigh">#CC000000</item>
        <item name="staticWhiteOverlayLow">#1AFFFFFF</item>
        <item name="staticWhiteOverlayMid">#33FFFFFF</item>
        <item name="staticWhiteOverlayHigh">#CCFFFFFF</item>

        <item name="statusCompletedBackground">#E8F5E9</item>
        <item name="statusCompletedText">#2E7D32</item>
        <item name="statusFailedBackground">#FFEBEE</item>
        <item name="statusFailedText">#B71C1C</item>
        <item name="chatReceiveBackground">#EAF4FF</item>
        <item name="chatReceiveText">#0F172A</item>
        <item name="chatSenderBackground">#4FC3F7</item>
        <item name="chatSenderText">#FFFFFF</item>
    </style>

    <!-- Player sheet: translucent so the previous screen shows while it is dragged down. -->
    <style name="Theme.NovelSerise.PlayerSheet">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Re-applied on top of the user's selected theme style (BaseActivity calls setTheme). -->
    <style name="ThemeOverlay.NovelSerise.PlayerSheet" parent="">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Settings list row: icon tile, label, chevron. -->
    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_muted</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SocialLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">62dp</item>
        <item name="android:background">@color/shop_card_stroke</item>
    </style>

    <!-- Bold page title used by the flat toolbars. -->
    <style name="TextAppearance.NovelSerise.PageTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Applied on top of every screen's theme (BaseActivity): hides scrollbar thumbs, sentence-case
      bold buttons with 12dp corners, and rounded card-coloured dialogs.
    -->
    <style name="ThemeOverlay.NovelSerise.NoScrollbars" parent="">
        <item name="android:scrollbarThumbVertical">@android:color/transparent</item>
        <item name="android:scrollbarThumbHorizontal">@android:color/transparent</item>
        <item name="textAppearanceButton">@style/TextAppearance.NovelSerise.Button</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.NovelSerise.Small</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.NovelSerise.MaterialDialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.NovelSerise.AlertDialog</item>
    </style>

    <style name="TextAppearance.NovelSerise.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearance.NovelSerise.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.NovelSerise.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ThemeOverlay.NovelSerise.MaterialDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/shop_card</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.NovelSerise.Dialog</item>
        <item name="textAppearanceButton">@style/TextAppearance.NovelSerise.Button</item>
    </style>

    <style name="ThemeOverlay.NovelSerise.AlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <item name="textAppearanceButton">@style/TextAppearance.NovelSerise.Button</item>
    </style>

    <style name="ToolbarTitleAppearance" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.NovelSeries.BottomNavigationLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_video_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_blank_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_video_background</item>
        <item name="postSplashScreenTheme">@style/Theme.NovelSerise</item>
    </style>

    <!-- Bottom sheets that draw their own rounded background: the default sheet container is
         made fully transparent so nothing shows outside the rounded corners. -->
    <style name="ThemeOverlay.NovelSerise.TransparentBottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NovelSerise.TransparentBottomSheet</item>
    </style>

    <style name="Widget.NovelSerise.TransparentBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Pill filter chip (selection look is applied in code). -->
    <style name="WriterFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_filter_chip</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.App.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize12dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize8dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize4dp" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="RoundedCornerImage8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>
