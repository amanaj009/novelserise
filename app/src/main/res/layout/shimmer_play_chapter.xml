<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playerSectionPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Cover Image Placeholder (100dp wide, 2:3 ratio) -->
        <View
            android:id="@+id/cardCoverPlaceholder"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Chapter Title Placeholder -->
        <View
            android:id="@+id/tvChapterTitlePlaceholder"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardCoverPlaceholder"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Novel Title Placeholder -->
        <View
            android:id="@+id/tvNovelTitlePlaceholder"
            android:layout_width="120dp"
            android:layout_height="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintStart_toEndOf="@id/cardCoverPlaceholder"
            app:layout_constraintTop_toBottomOf="@id/tvChapterTitlePlaceholder" />

        <!-- View Full Screen Placeholder -->
        <View
            android:id="@+id/tvViewFullScreenPlaceholder"
            android:layout_width="80dp"
            android:layout_height="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintStart_toEndOf="@id/cardCoverPlaceholder"
            app:layout_constraintTop_toBottomOf="@id/tvNovelTitlePlaceholder" />

        <!-- SeekBar Placeholder -->
        <View
            android:id="@+id/seekBarPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintTop_toBottomOf="@id/cardCoverPlaceholder" />

        <!-- Time Placeholders -->
        <View
            android:id="@+id/tvCurrentTimePlaceholder"
            android:layout_width="40dp"
            android:layout_height="14dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBarPlaceholder" />

        <View
            android:id="@+id/tvTotalTimePlaceholder"
            android:layout_width="40dp"
            android:layout_height="14dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/seekBarPlaceholder" />

        <!-- Control Buttons Placeholders (Centered horizontally) -->
        <View
            android:id="@+id/btnPlayPausePlaceholder"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCurrentTimePlaceholder" />

        <!-- Rewind 10s -->
        <View
            android:id="@+id/btnRewindPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintBottom_toBottomOf="@id/btnPlayPausePlaceholder"
            app:layout_constraintEnd_toStartOf="@id/btnPlayPausePlaceholder"
            app:layout_constraintTop_toTopOf="@id/btnPlayPausePlaceholder" />

        <!-- Previous -->
        <View
            android:id="@+id/btnPreviousPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintBottom_toBottomOf="@id/btnRewindPlaceholder"
            app:layout_constraintEnd_toStartOf="@id/btnRewindPlaceholder"
            app:layout_constraintTop_toTopOf="@id/btnRewindPlaceholder" />

        <!-- Forward 10s -->
        <View
            android:id="@+id/btnForwardPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintBottom_toBottomOf="@id/btnPlayPausePlaceholder"
            app:layout_constraintStart_toEndOf="@id/btnPlayPausePlaceholder"
            app:layout_constraintTop_toTopOf="@id/btnPlayPausePlaceholder" />

        <!-- Next -->
        <View
            android:id="@+id/btnNextPlaceholder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/rounded_shimmer_placeholder"
            app:layout_constraintBottom_toBottomOf="@id/btnForwardPlaceholder"
            app:layout_constraintStart_toEndOf="@id/btnForwardPlaceholder"
            app:layout_constraintTop_toTopOf="@id/btnForwardPlaceholder" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TabLayout Placeholder -->
    <View
        android:id="@+id/tabLayoutPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/rounded_shimmer_placeholder"
        app:layout_constraintTop_toBottomOf="@id/playerSectionPlaceholder" />

    <!-- Content Placeholder -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_shimmer_placeholder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutPlaceholder" />

</androidx.constraintlayout.widget.ConstraintLayout>
