<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/shop_card" />
            <stroke android:width="1dp" android:color="@color/shop_card_stroke" />
        </shape>
    </item>
    <!-- Warm glow at the top -->
    <item android:bottom="140dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="26dp" android:topRightRadius="26dp" />
            <gradient android:angle="270" android:startColor="#29FFC53D" android:endColor="#00FFC53D" />
        </shape>
    </item>
</layer-list>
